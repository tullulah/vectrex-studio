[project]
name = "aae_zektor"
type = "c-external"
target = "rp2350"

# AAE (Another Arcade Emulator) — Zektor (Sega G80, Z80 + Sega vector
# generator) — ported to run as a C game on the RP2350 cartridge via libvpy's
# SDK shim. WORK IN PROGRESS: see docs/AAE_RP2350_PORT.md.

[build]
command = "make"
args = ["aae_zektor_rp2350"]
artifact = "build_rp2350/aae_zektor_sd.bin"

[targets.rp2350]
args = ["aae_zektor_rp2350"]
artifact = "build_rp2350/aae_zektor_sd.bin"

# WASM build that runs in the IDE emulator panel (compiled against the pitrex-sim
# host SDK shim via emscripten). The IDE injects $PITREX_SIM_SDK + emcc.
[simulate]
command = "make"
args = ["sim"]
module = "build_wasm/game.js"
