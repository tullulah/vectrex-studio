# External C/C++ project imported into Vectrex Studio.
[project]
name = "snowbros_sbt"
type = "c-external"
target = "uvm2"

# Default build = the UVM2 image. The game (1.5MB with the 68000 ROM and
# Musashi tables) does NOT fit the 496K GAME_RAM, so it links into external
# PSRAM (UVM2_LOAD_PSRAM=1). A PSRAM payload is not a .um2 module — the
# multicart menu can't load it, our PSRAM loader does — hence the artifact is
# the flat .bin, not a .um2. HW validation of that loader is still pending.
[build]
command = "make"
args = ["uvm2"]
artifact = "build_uvm2/snowbros_sbt.bin"
deploy_extra = []

[targets.uvm2]
command = "make"
args = ["uvm2"]
artifact = "build_uvm2/snowbros_sbt.bin"

# Nuestro cartucho RP2350. Mismo programa y mismas fuentes que la imagen de
# arriba; lo que cambia es quien contesta al `svc`: alli el propio binario, aqui
# la BIOS del cartucho, por su tabla de funciones (doble nucleo — core 0
# materializa el haz por PIO+DMA mientras el juego corre en core 1).
#
# TIENE QUE ESTAR ESCRITO AQUI. El IDE fuerza el objetivo `rp2350` en "Build for
# SD"; si no encuentra [targets.rp2350] cae al [build] por defecto y copia a la
# tarjeta lo que ese produzca, sin fallar. En dkong eso puso el .js del simulador
# en la SD: lo avisaba en el log, y en la tarjeta el fallo era mudo.
[targets.rp2350]
command = "make"
args = ["rp2350"]
artifact = "build_rp2350/snowbros_sbt_sd.bin"

[env]
UVM2_LOAD_PSRAM = "1"

# WASM build that runs in the IDE emulator panel (compiled against the host
# SDK shim via emscripten). The IDE injects $PITREX_SIM_SDK + emcc.
[simulate]
command = "make"
args = ["sim", "CHEATS=1", "TILE_BOXES=1"]   # invulnerability dip ON + placeholder boxes for untraced sprites (capture runs want to SEE the unknowns); drop flags to play honest/clean
module = "build_wasm/game.js"

# Optional: prepend a toolchain bin dir to PATH for the build.
# [toolchain]
# path = "/opt/arm-toolchain/bin"

# Optional: environment overrides passed to the build.
# [env]
# PITREX_SDK = "/Users/you/projects/pitrex-baremetal"
