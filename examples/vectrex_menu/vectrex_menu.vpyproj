[project]
name = "vectrex_menu"
version = "0.1.0"
entry = "src/main.vpy"

[build]
output = "build/vectrex_menu.bin"
optimization = 2
debug_symbols = true

[sources]
vpy = ["src/**/*.vpy"]

[resources]
vectors = ["assets/vectors/**/*.vec"]
recordings = ["assets/recordings/**/*.vrec"]
music = ["assets/music/**/*.vmus"]
