{
  "version": "2.0",
  "name": "frog",
  "actions": [
    {
      "name": "idle",
      "sprite": "assets/vectors/frog_idle.vec",
      "loop": true
    },
    {
      "name": "walk",
      "sprite": "assets/animations/frog_walk.vanim",
      "loop": true
    },
    {
      "name": "snow1",
      "sprite": "assets/vectors/titchi_snow1.vec",
      "loop": true
    },
    {
      "name": "snow2",
      "sprite": "assets/vectors/titchi_snow2.vec",
      "loop": true
    },
    {
      "name": "ball",
      "sprite": "assets/vectors/titchi_ball.vec",
      "loop": true
    },
    {
      "name": "fire_side",
      "sprite": "assets/vectors/frog_fire_side.vec",
      "loop": false,
      "type": "shoot",
      "direction": "side",
      "mirror": true
    },
    {
      "name": "fire_down",
      "sprite": "assets/vectors/frog_fire_down.vec",
      "loop": false,
      "type": "shoot",
      "direction": "down",
      "mirror": false
    }
  ],
  "stats": {
    "hp": 3,
    "speed": 40,
    "action_duration": 180
  },
  "behavior": {
    "type": "patrol",
    "patrol": {
      "waypoints": [],
      "loop": true,
      "mirrorOnPatrol": true,
      "defaultFacing": "right",
      "patrolAction": "walk"
    },
    "chase_range": 80,
    "respawn": false,
    "wave": 0
  },
  "state_machine": {
    "initial_state": "normal",
    "states": [
      {
        "name": "normal",
        "action": "walk",
        "decay_frames": 0,
        "decay_to": "",
        "on_event": [
          {
            "event": "onSnowHit",
            "to": "snow1"
          },
          {
            "event": "onFireSide",
            "to": "fire_side"
          },
          {
            "event": "onFireDown",
            "to": "fire_down"
          }
        ]
      },
      {
        "name": "snow1",
        "action": "snow1",
        "decay_frames": 120,
        "decay_to": "normal",
        "on_event": [
          {
            "event": "onSnowHit",
            "to": "snow2"
          }
        ]
      },
      {
        "name": "snow2",
        "action": "snow2",
        "decay_frames": 180,
        "decay_to": "snow1",
        "on_event": [
          {
            "event": "onSnowHit",
            "to": "ball"
          }
        ]
      },
      {
        "name": "ball",
        "action": "ball",
        "decay_frames": 300,
        "decay_to": "snow2",
        "on_event": [
          {
            "event": "onKick",
            "to": "normal"
          }
        ]
      },
      {
        "name": "fire_side",
        "action": "fire_side",
        "decay_frames": 40,
        "decay_to": "normal",
        "on_event": []
      },
      {
        "name": "fire_down",
        "action": "fire_down",
        "decay_frames": 40,
        "decay_to": "normal",
        "on_event": []
      }
    ]
  }
}
