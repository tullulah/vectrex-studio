# Rust / Cargo build artifacts
/target/
buildtools/target/
core/target/
**/*.rs.bk
emulator_v2/target/

# Debug cart firmware build artifacts (cross-compilation target dir)
hardware/debug_cart/firmware/target/

# Examples: intermediate build artifacts (keep .asm/.bin, ignore linker/assembler temps)
examples/**/*.elf
examples/**/*.o
examples/**/*.s
examples/**/src/*.bin
# Stray test binaries at examples root
examples/test_arm.bin
# RP2350 generated ASM (intermediate, not needed alongside the 6809 .asm)
examples/**/*_rp2350.asm

# Generated assembly outputs (use redirection to keep if needed)
/*.asm
tests/*.asm

# If you want to ignore all top-level generated .asm add (commented):
#/*.asm

# Editor / IDE
.vscode/
.idea/
*.iml

# OS / Misc
.DS_Store
Thumbs.db

# Swap / backup / temp
*.swp
*.swo
*~
*.tmp

# Backup directory (local files, not versioned)
backup/*
!backup/README.md

# Logs
*.log

# Optional: uncomment to ignore Cargo.lock for libraries (keep for bins)
# Cargo.lock

# Node / VS Code extension
node_modules/
vscode-extension/node_modules/
vscode-extension/dist/
dist/
 
# C++ experimental host / not part of Rust core build

# Vectrexy reference implementation (backup only, not for version control)
vectrexy/

# Turmoil reference (external game for testing, not part of VPy)
turmoil_reference/

# VIDE project files (external tool, not part of VPy)
examples/vide project/

# C++ parity host (vectrexy) versionado: marker2

# VIDE (Vectrex IDE) - binary distribution
examples/vide/
vide/

# Christman2024 - Reference ROM for music playback (malbanGit)
Christman2024/
VRelease_2017_04_29/

# WIP projects (local only, not ready for version control)
examples/clockmakers_crypt/
examples/clockmakers_crypt_web/
# CON BARRA DELANTE: solo el hardware/ DE LA RAIZ. Sin anclar, esta regla se comia
# cualquier directorio llamado hardware a cualquier profundidad — y el emulador tiene uno
# (ide/frontend/src/emulator/hardware). Los ficheros que ya estaban versionados seguian
# apareciendo, asi que el problema era invisible: solo los NUEVOS se ignoraban, en
# silencio. Ramp.ts se quedo fuera de su propio commit y solo se noto porque git avisa al
# hacer `add` explicito.
/hardware/

# Vector-movie SOURCE videos (dev-only, copyrighted — NOT part of the distributed
# IDE and never committed). Regenerate/download with tools/fetch/url2vmov.sh.
examples/tdcm.mp4
examples/badapple.mov
examples/*.mp4
examples/*.mov

# Python bytecode cache (dev tools)
tools/**/__pycache__/

# Instaladores construidos: 100 MB que GitHub rechaza, y no son fuente
*.dmg
*.AppImage
*.exe

# Cargo tree of the cartridge bus: 522 MB of intermediate objects.
ide/electron/resources/uvmc2-sdk/vectrex-bus/target/
ide/electron/resources/uvmc2-sdk/vectrex-draw/target/
ide/electron/resources/uvmc2-sdk/vectrex-draw/cabi/target/

# snowbros_sbt: source, assets and the .um2 are versioned; NOT the debug dumps (13 MB of
# ramdumps, 6.8 MB of dumps) nor the build trees.
examples/snowbros_sbt/ramdumps/
examples/snowbros_sbt/dumps/
examples/snowbros_sbt/build/
examples/snowbros_sbt/build_wasm/
examples/snowbros_sbt/build_uvm2/pico/
examples/*/build/uvm2/

# THE ARCADE ROM DOES NOT GO IN HERE. This repository is PUBLIC
# (github.com/tullulah/vectrex-studio, checked with `gh repo view`), and the project's
# standard is that the romset lives OUTSIDE the image and the game reads it from the SD,
# MAME model. `sb_rom.h` is the same ROM in a C header: same material, different wrapper.
examples/*/rom/*.zip
examples/*/src/sb_rom.h
examples/*/rom/palette_table.bin
